{
  "name": "minha-historia-na-web",
  "compatibility_date": "2026-10-06",
  "main": "src/worker.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/minha-historia-na-web/browser",
    "binding": "ASSETS",
    "run_worker_first": ["/api/weather"],
    "not_found_handling": "single-page-application"
  }
}
